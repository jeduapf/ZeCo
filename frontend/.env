# Frontend Environment Configuration
# These variables should be prefixed with VITE_ to be accessible in Vite

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_VERSION=v1

# App Configuration
VITE_APP_NAME=ZeCo
VITE_DEBUG=true
VITE_LANG=en

# Token Configuration (mirrors backend for consistency)
VITE_TOKEN_REFRESH_THRESHOLD_MINUTES=15
VITE_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Feature Flags
VITE_ENABLE_WEBSOCKET=true
