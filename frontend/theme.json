    "shadows": {
        "sm": "0 1px 3px rgba(15, 23, 42, 0.08)",
        "md": "0 4px 6px rgba(15, 23, 42, 0.1)",
        "lg": "0 10px 15px rgba(15, 23, 42, 0.12)",
        "xl": "0 20px 25px rgba(15, 23, 42, 0.15)"
    },
    "transitions": {
        "fast": "0.15s ease",
        "base": "0.2s ease",
        "slow": "0.3s ease"
    }
