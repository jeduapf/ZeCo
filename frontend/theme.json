        },
        "login": {
            "title": "Login",
            "description": "Sign in to your account"
        }
    },
    "colors": {
        "primary": {
            "main": "#2d6a4f",
            "light": "#52b788",
            "dark": "#1b4332",
            "contrast": "#ffffff"
        },
        "secondary": {
            "main": "#2c3e50",
            "light": "#34495e",
            "dark": "#1a252f",
            "contrast": "#ffffff"
        },
        "background": {
            "default": "#ffffff",
            "paper": "#f1faee",
            "navbar": "rgba(255, 255, 255, 0.95)",
            "overlay": "rgba(0, 0, 0, 0.5)"
