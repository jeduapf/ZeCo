            "hint": "#cccccc"
        },
        "status": {
            "success": "#059669",
            "warning": "#D97706",
            "error": "#DC2626",
            "info": "#0284C7"
        },
        "interactive": {
            "hover": "rgba(0, 172, 193, 0.08)",
            "selected": "rgba(0, 172, 193, 0.12)",
            "disabled": "rgba(0, 0, 0, 0.12)",
            "focus": "rgba(0, 172, 193, 0.24)"
        },
        "borders": {
            "light": "#E2E8F0",
            "medium": "#CBD5E1",
            "dark": "#94A3B8"
        }
    },
    "typography": {
        "fontFamily": {
            "primary": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
            "secondary": "'Roboto', sans-serif",
            "monospace": "'Fira Code', 'Courier New', monospace"
        },
        "fontSize": {
            "xs": "0.75rem",
            "sm": "0.875rem",
